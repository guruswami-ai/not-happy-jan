# Not-Happy-Jan configuration — copy to .env and fill in.
# Real .env is gitignored; only this example is tracked.

# ---------------------------------------------------------------------------
# TTS backend
# ---------------------------------------------------------------------------
# Engine options:
#   qwen   (default) — local Qwen3-TTS-0.6B via the NHJ server on localhost:9992
#                       (Apple Silicon Mac; the cloned character voices)
#   none             — disable TTS
TTS_ENGINE=qwen
NHJ_TTS_URL=http://localhost:9992
NHJ_TTS_MODEL_TIER=fast

# ---------------------------------------------------------------------------
# Character / voice
# ---------------------------------------------------------------------------
# Default character used for vibes. Must match a folder name under voices/.
NHJ_DEFAULT_CHARACTER=jan
# Set to 'karren' to force Karren for errors regardless of default
# (normally auto-routed by severity)
# NHJ_ERROR_CHARACTER=karren

# ---------------------------------------------------------------------------
# Inference muzak (the streaming mixer — av+sounddevice, macOS)
# ---------------------------------------------------------------------------
# All audio (music bed + beeps + voice) runs through one streaming mixer.
# NHJ_MUZAK_VOLUME=0.5           # music bed level
# NHJ_MUZAK_DUCK_GAIN=0.22       # music level while a voice/beep is sounding
# NHJ_MUZAK_TRANSFER=1           # transfer-button beep on every hold transition
# NHJ_PHONE_FX=0                 # 1 = telephone bandpass+compression on the voice (call-centre colour)

# ---------------------------------------------------------------------------
# Hardware notification devices — FUTURE STAGED RELEASE (not in the macOS v1).
# The adapter layer is built to extend to LaMetric / ULANZI / Divoom / ESP32 bell /
# Logitech haptics, but those are experimental and disabled by default for now.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# MCP server transport (for remote fleet nodes)
# ---------------------------------------------------------------------------
NHJ_TRANSPORT=stdio
# NHJ_HOST=0.0.0.0    # set to LAN IP to expose to remote Claude sessions
# NHJ_PORT=8765

# ---------------------------------------------------------------------------
# Dynamic voices (optional) — a local LLM rephrases each notification in-character
# instead of reading static phrase banks. NHJ ships with ocker-bogan-nano, its own
# Australian-tuned abliterated Qwen2.5-1.5B fine-tune, served locally (see `nhj install-model`). Any
# OpenAI-compatible endpoint works; off by default, falls back to static banks.
# ---------------------------------------------------------------------------
# NHJ_DYNAMIC=1
# NHJ_DYNAMIC_BASE_URL=http://127.0.0.1:8030/v1     # ocker-bogan-nano (local llama.cpp server)
# NHJ_DYNAMIC_MODEL=ocker-bogan-nano
# NHJ_DYNAMIC_API_KEY=not-needed       # dummy is fine for the local model
# NHJ_DYNAMIC_TEMP=0.9
# NHJ_DYNAMIC_TIMEOUT=8

# Swearing = Jan's ockerism 11 (`nhj set jan.ockerism 11` / `nhj swearing on`).
# Strong swears are bleeped by default; change the bleep or go raw:
# NHJ_CENSOR=quack          # quack (default) | beep | honk | off
# (or live + persisted: `nhj censor quack|beep|honk|off`)
