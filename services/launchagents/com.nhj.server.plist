<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nhj.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/not-happy-jan/.venv/bin/python</string>
    <string>/path/to/not-happy-jan/src/nhj/tts_server.py</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>7863</string>
    <string>--load</string><string>fast</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/not-happy-jan</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HF_HOME</key><string>/Users/YOUR_USERNAME/.cache/huggingface</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/nhj-server.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/nhj-server.err.log</string>
</dict>
</plist>
