{
  "description": "NHJ Claude Code lifecycle hooks",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-m", "nhj.hook"],
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-m", "nhj.prompt_hook"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-m", "nhj.prompt_hook"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-m", "nhj.prompt_hook"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
