<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Not-Happy-Jan warm Qwen3-TTS daemon on :9992. Serves the NHJ cast
  (jan/bazza/karren) from the repo voices/ directory.

  Manage:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.guruswami.nhj-tts.plist
    launchctl kickstart -k gui/$(id -u)/com.guruswami.nhj-tts
    launchctl bootout gui/$(id -u)/com.guruswami.nhj-tts
  Logs: ~/devops/not-happy-jan/logs/nhj-tts.{out,err}.log

  To restore /opt/tts: bootout this, then
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.guruswami.qwen-tts.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.guruswami.nhj-tts</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/devops/not-happy-jan/.venv/bin/python</string>
        <string>-m</string>
        <string>nhj.tts_server</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>9992</string>
        <string>--load</string>
        <string>fast</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/devops/not-happy-jan</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>NHJ_VOICES_DIR</key>
        <string>/opt/tts/characters</string>
        <key>HF_HOME</key>
        <string>/Users/YOUR_USERNAME/.cache/huggingface</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/devops/not-happy-jan/logs/nhj-tts.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/devops/not-happy-jan/logs/nhj-tts.err.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
